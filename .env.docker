APP_NAME="PIOS Smart City"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Connection (Docker default service: db)
DB_CONNECTION=envsogo_main
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pios
DB_USERNAME=pios
DB_PASSWORD=secret

# PIOS Specific Connections
DB_HOST_S_ADMIN=db
DB_PORT_S_ADMIN=3306
DB_DATABASE_S_ADMIN=pios
DB_USERNAME_S_ADMIN=pios
DB_PASSWORD_S_ADMIN=secret

DB_HOST_TENANT=db
DB_PORT_TENANT=3306
DB_DATABASE_TENANT=pios
DB_USERNAME_TENANT=pios
DB_PASSWORD_TENANT=secret

DB_PERSISTENT=false

# Redis & Caching
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Vite HMR
VITE_PORT=5173
VITE_HMR_HOST=localhost

# Mail Settings
MAIL_MAILER=log
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="pios@example.com"
MAIL_FROM_NAME="${APP_NAME}"
